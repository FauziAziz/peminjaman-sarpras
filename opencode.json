{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/privacy-free",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      "opencode.json": "deny",
      "docs/0*.md": "deny",
      ".opencode/*": "deny",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "php artisan route:list*": "allow",
      "php artisan migrate:status*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "php artisan migrate:fresh*": "deny",
      "php artisan db:wipe*": "deny"
    }
  }
}
